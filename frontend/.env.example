# FixMyCampus Environment Configuration

# Backend API URL (use empty string for local proxy, or your Vercel backend URL for production)
VITE_API_BASE_URL=

# Supabase Credentials (optional - app works out of the box with built-in mock/demo store)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# College Email Domain Policy
VITE_COLLEGE_EMAIL_DOMAIN=@campus.edu
