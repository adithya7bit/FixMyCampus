# Copy to .env.local. Never commit real secrets.

# --- Supabase (required for production) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Service role is SERVER ONLY. Do not prefix with VITE_.
# Used by optional admin scripts, not the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox (optional — stylized campus map is the fallback) ---
VITE_MAPBOX_TOKEN=pk.eyJ...
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# --- Campus ---
VITE_CAMPUS_NAME=Meridian Institute of Technology
VITE_CAMPUS_LAT=28.5450
VITE_CAMPUS_LNG=77.1930

# --- Optional AI (server only) ---
GEMINI_API_KEY=
VITE_AI_ENABLED=false
